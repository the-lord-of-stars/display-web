---
const { header: headerName, content: contentName, needPercent = true } = Astro.props
---

<div
  class='z-10 group fixed bottom-8 end-4 transition-all flex flex-col gap-y-4 sm:end-8'
  id='action-buttons'
>
  <slot name='other-icons' />
  <button
    aria-label='Back to Top'
    class='pixel-top-btn relative size-10 flex items-center justify-center rounded-[4px] border-2 border-transparent bg-muted text-muted-foreground duration-300 hover:border-border/75 sm:size-12 opacity-0'
    id='to-top-btn'
  >
    <div
      class='top-text absolute bottom-0 end-0 start-0 top-0 flex items-center justify-center group-[.ended]:opacity-0'
    >
      <span class='text pixel-font text-xs'>10</span>
      <span class='pixel-font text-[0.6rem]'>%</span>
    </div>
    {/* Pixel up-arrow, drawn on a 7x7 grid */}
    <svg
      class='top-icon size-5 group-[.ended]:opacity-100'
      viewBox='0 0 7 7'
      fill='currentColor'
      shape-rendering='crispEdges'
      aria-hidden='true'
    >
      <rect x='3' y='0' width='1' height='7'></rect>
      <rect x='2' y='1' width='3' height='1'></rect>
      <rect x='1' y='2' width='5' height='1'></rect>
      <rect x='0' y='3' width='7' height='1'></rect>
    </svg>
  </button>
</div>

<script is:inline define:vars={{ headerName, contentName, needPercent }}>
  const actionBtns = document.getElementById('action-buttons')
  const scrollBtn = document.getElementById('to-top-btn')
  const scrollPercentEl = scrollBtn.children[0].children[0]
  const targetHeader = document.getElementById(headerName)
  const articleElement = document.getElementById(contentName)

  // scroll to top
  function callback(entries) {
    entries.forEach((entry) => {
      // only show the action buttons when the heading is out of view
      actionBtns.classList.toggle('show', !entry.isIntersecting)
    })
  }
  scrollBtn.addEventListener('click', () => {
    document.documentElement.scrollTo({ behavior: 'smooth', top: 0 })
  })
  if (targetHeader) {
    const observer = new IntersectionObserver(callback)
    observer.observe(targetHeader)
  } else {
    console.error(`Element with ID ${headerName} not found.`)
  }
  if (needPercent) {
    // Reading progress through the article, 0-100.
    // Measured on every scroll (images can change the height after load), clamped so it
    // can never go negative, and falls back to whole-page progress for short articles.
    function readProgress() {
      const viewport = window.innerHeight
      const scrollY = window.scrollY
      const rect = articleElement ? articleElement.getBoundingClientRect() : null
      if (rect && rect.height > viewport * 0.5) {
        const start = rect.top + scrollY
        const range = rect.height - viewport
        if (range > 0) return (scrollY - start) / range
      }
      const pageRange = document.documentElement.scrollHeight - viewport
      return pageRange > 0 ? scrollY / pageRange : 1
    }

    document.addEventListener(
      'scroll',
      () => {
        const raw = readProgress()
        const percent = Math.min(100, Math.max(0, Math.round(raw * 100)))
        scrollPercentEl.innerText = percent.toString()
        // Past the end of the article: show the arrow instead of a number
        actionBtns.classList.toggle('ended', raw > 1)
      },
      { passive: true }
    )
  } else {
    actionBtns.classList.add('ended')
  }
</script>

<style>
  .pixel-top-btn:hover {
    color: hsl(var(--primary));
    border-color: hsl(var(--primary) / 0.6);
    box-shadow: 3px 3px 0 0 hsl(var(--primary) / 0.4);
  }

  .pixel-top-btn:active {
    transform: translate(2px, 2px);
    box-shadow: none;
  }

  #action-buttons {
    transform: translateY(4rem);
    &.show {
      transform: translateY(0);
      & #to-top-btn {
        opacity: 1;
      }
    }

    /* To top button status change */
    & #to-top-btn {
      & .top-text,
      & .top-icon {
        transition-property: opacity;
        transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
        transition-duration: 150ms;
      }
      & .top-text {
        opacity: 1;
      }
      & .top-icon {
        opacity: 0;
      }
    }
    &.ended #to-top-btn,
    & #to-top-btn:hover {
      & .top-text {
        opacity: 0;
      }
      & .top-icon {
        opacity: 1;
      }
    }
  }
</style>
