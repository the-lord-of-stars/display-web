{/* Use inline mode to quick load color, which can avoid splash */}
<script is:inline>
  function simpleSetTheme() {
    let theme = localStorage.getItem('theme')
    // If undefined or 'system', get from system
    if (!theme || theme === 'system') {
      theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }
    document.documentElement.classList.toggle('dark', theme === 'dark')
    document
      .querySelector('meta[name="theme-color"]')
      ?.setAttribute('content', theme === 'dark' ? '#120E0D' : '#FBF9F4')
  }
  simpleSetTheme()
  document.addEventListener('astro:page-load', () => simpleSetTheme())
</script>

<script>
  import { Icons } from '../../libs/icons'
  import { listenThemeChange } from '../../utils'

  // Listen for theme change event
  listenThemeChange()
  // Listen for toast event: shown as a small RPG-style dialog box whose text types out
  document.addEventListener('toast', (e) => {
    const { message } = (e as CustomEvent).detail
    document.querySelectorAll('.rpg-toast').forEach((el) => el.remove())
    const toast = document.createElement('div')
    toast.className = 'rpg-toast rpg-dialog animate fixed bottom-8 z-20 flex items-center gap-2'
    toast.setAttribute('role', 'status')
    toast.innerHTML = `<svg width='16' height='16' viewBox='0 0 24 24' fill='currentColor' aria-hidden='true'>${Icons.info}</svg> <span class='rpg-toast-text'></span>`
    const textEl = toast.querySelector('.rpg-toast-text') as HTMLElement
    document.body.appendChild(toast)

    const text = String(message)
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    if (reduce) {
      textEl.textContent = text
    } else {
      let i = 0
      const timer = setInterval(() => {
        textEl.textContent = text.slice(0, ++i)
        if (i >= text.length) clearInterval(timer)
      }, 24)
    }
    setTimeout(() => {
      toast.remove()
    }, 3000)
  })
</script>
