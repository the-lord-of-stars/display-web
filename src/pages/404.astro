---
import { Button } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'

const meta = {
  description: 'Not found',
  title: '404'
}

// Typed out under the big number, one after another
const lines = [
  'This page wandered off into the library...',
  'Even the lamp could not find it.',
  'Maybe head back to the desk?'
]
---

<PageLayout {meta} dust='.notfound-code'>
  <div class='notfound flex flex-col items-center px-4 py-14 text-center sm:px-6 lg:px-8'>
    <p class='pixel-font notfound-kicker'>Error</p>

    <h1 class='notfound-code pixel-font'>404</h1>

    <p class='notfound-status pixel-font' data-lines={JSON.stringify(lines)}>
      <span class='sr-only'>{lines.join(' ')}</span>
      <span aria-hidden='true'>
        <span class='notfound-text'>{lines[0]}</span><span class='notfound-caret'></span>
      </span>
    </p>

    <Button title='Back to home' href='/' variant='ahead' class='mt-8' />
  </div>
</PageLayout>

<script>
  const status = document.querySelector<HTMLElement>('.notfound-status')
  const textEl = status?.querySelector<HTMLElement>('.notfound-text')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (status && textEl && !reduceMotion) {
    const lines: string[] = JSON.parse(status.dataset.lines || '[]')
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
    let index = 0

    const run = async () => {
      textEl.textContent = ''
      await sleep(500)
      while (true) {
        const line = lines[index]
        status.classList.add('is-typing')
        for (let i = 1; i <= line.length; i++) {
          textEl.textContent = line.slice(0, i)
          await sleep(38 + Math.random() * 40)
        }
        status.classList.remove('is-typing')
        await sleep(2400)
        status.classList.add('is-typing')
        for (let i = line.length - 1; i >= 0; i--) {
          textEl.textContent = line.slice(0, i)
          await sleep(18)
        }
        await sleep(300)
        index = (index + 1) % lines.length
      }
    }
    run()
  }
</script>

<style>
  .notfound-kicker {
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    color: hsl(var(--muted-foreground));
    animation: nf-in 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Big pixel number with a hard, stepped drop shadow */
  .notfound-code {
    margin-top: 0.5rem;
    font-size: clamp(4.5rem, 18vw, 9rem);
    line-height: 1;
    color: hsl(var(--foreground));
    text-shadow:
      4px 4px 0 hsl(var(--primary) / 0.55),
      8px 8px 0 hsl(var(--primary) / 0.2);
    animation:
      nf-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) 0.1s both,
      nf-float 3.2s steps(4, end) 1.2s infinite;
  }

  .notfound-status {
    margin-top: 1.75rem;
    min-height: 1.5em;
    font-size: 0.8rem;
    color: hsl(var(--muted-foreground));
  }

  .notfound-caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.2em;
    vertical-align: -0.12em;
    background: hsl(var(--primary));
    animation: nf-blink 1.05s steps(1, end) infinite;
  }

  .notfound-status.is-typing .notfound-caret {
    animation: none;
  }

  @keyframes nf-in {
    from {
      opacity: 0;
      transform: translate3d(0, 12px, 0);
    }
    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  /* Bobs up and down in whole-pixel steps */
  @keyframes nf-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0);
    }
    50% {
      transform: translate3d(0, -6px, 0);
    }
  }

  @keyframes nf-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notfound-kicker,
    .notfound-code,
    .notfound-caret {
      animation: none;
    }
  }
</style>
