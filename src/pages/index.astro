---
import { Image } from 'astro:assets'

import { Quote } from 'astro-pure/advanced'
import { PostPreview } from 'astro-pure/components/pages'
import { getBlogCollection, sortMDByDate } from 'astro-pure/server'
import { Button, Card, Icon, Label } from 'astro-pure/user'
import PageLayout from '@/layouts/BaseLayout.astro'
import ProjectCard from '@/components/home/ProjectCard.astro'
import Section from '@/components/home/Section.astro'
import SkillLayout from '@/components/home/SkillLayout.astro'
import avatar from '@/assets/avatar.png'
import config from '@/site-config'

const languages = ['Python', 'Java', 'Haskell', 'C', 'Assembly Language']
const frontend = ['TypeScript', 'Tailwind', 'React']
const backend = ['SQL', 'Milvus', 'Chroma']
const libraries = ['LangChain', 'Scikit-learn', 'Numpy', 'NLTK', 'LangGraph']
const framework = ['Vercel', 'Waline', 'Hexo', 'Quarto', 'Flask', 'Gradio', 'FastAPI']

// Typed out one after another under the name
const statusLines = ['MSc @ Carnegie Mellon University', 'Exploring Human-AI interaction']

const MAX_POSTS = 2
const allPosts = await getBlogCollection()
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS)
---

<PageLayout meta={{ title: 'Home' }} highlightColor='#c49a52' dust='.hero-avatar'>
  <main class='relative z-10 flex w-full flex-col items-center'>
    <section class='hero-enter mb-10 flex flex-col items-center gap-y-7' id='content-header'>
      <div class='hero-avatar-wrap' role='button' tabindex='0' aria-label='Say hi'>
        <Image
          src={avatar}
          alt='profile'
          class='hero-avatar h-28 w-auto rounded-full border p-1'
          loading='eager'
        />
      </div>

      <div class='flex flex-col items-center gap-y-4'>
        <h1 class='hero-title text-3xl font-bold'>
          <span class='hero-title-inner'>{config.author}</span>
        </h1>

        <p class='hero-status' data-lines={JSON.stringify(statusLines)}>
          <span class='sr-only'>{statusLines.join('. ')}</span>
          <span class='hero-status-stack' aria-hidden='true'>
            {
              /* Invisible ghosts reserve the width of the longest line so typing never shifts layout */
            }
            {statusLines.map((line) => <span class='hero-status-ghost'>{line}</span>)}
            <span class='hero-status-live'>
              <span class='hero-status-text'>{statusLines[0]}</span><span class='hero-status-caret'
              ></span>
            </span>
          </span>
        </p>

        <div class='hero-labels flex flex-wrap justify-center gap-x-7 gap-y-3'>
          <div class='hero-label-item'>
            <Label title='United Kingdom'>
              <Icon name='location' class='size-5' slot='icon' />
            </Label>
          </div>

          <div class='hero-label-item'>
            <Label
              title='Github'
              as='a'
              href='https://github.com/the-lord-of-stars'
              target='_blank'
            >
              <Icon name='github' class='size-5' slot='icon' />
            </Label>
          </div>

          <div class='hero-label-item'>
            <Label
              title='LinkedIn'
              as='a'
              href='https://www.linkedin.com/in/zefei-xie-023644339/'
              target='_blank'
            >
              <Icon name='link' class='size-5' slot='icon' />
            </Label>
          </div>

          <div class='hero-label-item'>
            <Label
              title='Discord'
              as='a'
              href='https://discordapp.com/users/1288076012713807895'
              target='_blank'
            >
              <Icon name='discord' class='size-5' slot='icon' />
            </Label>
          </div>

          <div class='hero-label-item'>
            <Label title='Email me' as='a' href='mailto:1506894634@qq.com' target='_blank'>
              <Icon name='email' class='size-5' slot='icon' />
            </Label>
          </div>
        </div>
      </div>
    </section>

    <div id='content' class='flex flex-col gap-y-10 md:w-4/5 lg:w-5/6'>
      <Section title='About'>
        <div class='first-screen-reveal'>
          <p class='text-muted-foreground'>CSAI Student</p>

          <p class='text-muted-foreground'>
            I'm a <strong>technology enthusiast</strong> with a passion for
            <strong>AI, data integration, and software development</strong>. Currently, I'm a
            student at
            <a
              href='https://www.nottingham.ac.uk/'
              target='_blank'
              rel='noopener noreferrer'
              style='text-decoration: underline;'
            >
              <strong>University of Nottingham</strong>
            </a>, where I explore
            <strong>AI-driven schema matching and interoperability solutions</strong>. My research
            focuses on investigating ways AI can enhance
            <strong>data mapping and processing</strong>, with particular interest in
            <strong>AI agents</strong>. I'm especially interested in applying artificial
            intelligence to natural language processing, as well as making sense of complex data
            structures through <strong>data science and engineering</strong>.
          </p>

          <Button title='More about me' class='w-fit self-end' href='/about' variant='ahead' />
        </div>
      </Section>

      {
        allPostsByDate.length > 0 && (
          <div class='scroll-reveal blog-section-reveal'>
            <Section title='Posts'>
              <ul class='flex flex-col gap-y-1.5 sm:gap-y-2'>
                {allPostsByDate.map((p, index) => (
                  <li
                    class={`blog-post-reveal delay-${index + 1} flex flex-col gap-x-2 sm:flex-row`}
                  >
                    <PostPreview post={p} detailed />
                  </li>
                ))}
              </ul>

              <div class='blog-post-reveal delay-3 flex justify-end'>
                <Button title='More posts' class='w-fit self-end' href='/blog' variant='ahead' />
              </div>
            </Section>
          </div>
        )
      }

      <Section title='Education'>
        <div class='scroll-reveal scroll-reveal-left delay-1'>
          <Card
            as='a'
            heading='Carnegie Mellon University'
            subheading='Master of Science Intelligent Information System'
            date='August 2026 - '
            href='https://www.cmu.edu/'
          >
            {}
          </Card>
        </div>

        <div class='scroll-reveal scroll-reveal-right delay-2'>
          <Card
            as='a'
            heading='University of Nottingham'
            subheading='BSc Hons Computer Science with Artificial Intelligence'
            date='September 2022 - July 2026'
            href='https://www.nottingham.ac.uk/studywithus/ugstudy/courses/UG/Computer-Science-with-Artificial-Intelligence-BSc-Hons-U6UCMPAI.html'
          >
            {}
          </Card>
        </div>
      </Section>

      <Section title='Projects'>
        <div class='grid grid-cols-1 gap-3 sm:grid-cols-2'>
          <div class='scroll-reveal scroll-reveal-left delay-1'>
            <Card
              as='a'
              href='https://vis4sense.github.io/agentic-vis-2025/'
              heading='IEEE VIS 2025 GenxAI challenge'
              subheading='An agent to generate visualization report'
            />
          </div>

          <div class='scroll-reveal scroll-reveal-right delay-2'>
            <Card
              as='a'
              href='https://the-lord-of-stars.github.io/Data-Analytics-and-AI-Curriculum-project/'
              heading='Quarto Template'
              subheading='A template for UNUK mathmetics center'
            />
          </div>

          <div class='scroll-reveal scroll-reveal-left delay-2'>
            <Card
              as='a'
              href='https://github.com/the-lord-of-stars/team32-project'
              heading='IBM Watsonx Assistant'
              subheading='AI assistant for new students'
            />
          </div>

          <div class='scroll-reveal scroll-reveal-right delay-3'>
            <Card
              as='a'
              href='/projects'
              heading='More projects'
              subheading='Check out more projects...'
            />
          </div>
        </div>
      </Section>

      <Section title='Skills'>
        <div class='scroll-reveal delay-1'>
          <SkillLayout title='Languages' skills={languages} />
        </div>

        <div class='scroll-reveal delay-2'>
          <SkillLayout title='Frontend' skills={frontend} />
        </div>

        <div class='scroll-reveal delay-3'>
          <SkillLayout title='Backend' skills={backend} />
        </div>

        <div class='scroll-reveal delay-1'>
          <SkillLayout title='Libraries' skills={libraries} />
        </div>

        <div class='scroll-reveal delay-2'>
          <SkillLayout title='Framework' skills={framework} />
        </div>
      </Section>
    </div>
  </main>
</PageLayout>

<script src='/scripts/home-reveal.js' defer></script>

<script>
  // Typewriter for the status line under the name.
  const status = document.querySelector<HTMLElement>('.hero-status')
  const textEl = status?.querySelector<HTMLElement>('.hero-status-text')
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

  if (status && textEl && !reduceMotion) {
    const lines: string[] = JSON.parse(status.dataset.lines || '[]')
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms))
    let index = 0

    const type = async (line: string) => {
      for (let i = 1; i <= line.length; i++) {
        textEl.textContent = line.slice(0, i)
        await sleep(42 + Math.random() * 40)
      }
    }
    const erase = async () => {
      const line = textEl.textContent || ''
      for (let i = line.length - 1; i >= 0; i--) {
        textEl.textContent = line.slice(0, i)
        await sleep(22)
      }
    }

    const loop = async () => {
      textEl.textContent = ''
      await sleep(650) // let the name finish rising first
      while (true) {
        status.classList.add('is-typing')
        await type(lines[index])
        status.classList.remove('is-typing')
        await sleep(2600)
        status.classList.add('is-typing')
        await erase()
        await sleep(350)
        index = (index + 1) % lines.length
      }
    }

    loop()
  }

  // Click (or Enter/Space on) the avatar: pixel hearts and steam rise from her cup.
  const avatarWrap = document.querySelector<HTMLElement>('.hero-avatar-wrap')
  const HEART = ['.##.##.', '#######', '#######', '.#####.', '..###..', '...#...']
  // One element per sprite: a 1px dot whose box-shadow paints the other pixels.
  // A dark outline is added around the shape so it reads on top of the portrait.
  const spriteShadow = (rows: string[], px: number, outline: string) => {
    const on = (x: number, y: number) => rows[y]?.[x] === '#'
    const shadows: string[] = []
    for (let y = -1; y <= rows.length; y++) {
      for (let x = -1; x <= rows[0].length; x++) {
        if (on(x, y)) {
          shadows.push(`${x * px}px ${y * px}px 0 0 currentColor`)
        } else if (on(x - 1, y) || on(x + 1, y) || on(x, y - 1) || on(x, y + 1)) {
          shadows.push(`${x * px}px ${y * px}px 0 0 ${outline}`)
        }
      }
    }
    return shadows.join(',')
  }
  const heartShadow = spriteShadow(HEART, 3, 'rgba(70, 40, 30, 0.85)')

  const puff = () => {
    if (!avatarWrap || reduceMotion) return
    const count = 7
    for (let i = 0; i < count; i++) {
      const isHeart = i % 3 !== 2
      const el = document.createElement('span')
      el.className = 'avatar-particle'
      el.style.color = isHeart ? (i % 2 ? '#ff7f9e' : '#ffb3c4') : 'rgba(255, 250, 240, 0.95)'
      if (isHeart) {
        el.style.boxShadow = heartShadow
      } else {
        const size = 4 + Math.round(Math.random() * 2)
        el.style.width = el.style.height = `${size}px`
        el.style.background = 'currentColor'
        el.style.boxShadow = '0 0 0 1px rgba(70, 40, 30, 0.5)'
      }
      // Start around the cup (lower middle of the portrait)
      el.style.left = `${40 + Math.random() * 14}%`
      el.style.top = `${74 + Math.random() * 6}%`
      avatarWrap.appendChild(el)

      const drift = (Math.random() - 0.5) * 50
      const rise = 90 + Math.random() * 60
      el.animate(
        [
          { transform: 'translate(0, 0)', opacity: 0 },
          { opacity: 1, offset: 0.15 },
          { transform: `translate(${drift}px, ${-rise}px)`, opacity: 0 }
        ],
        {
          duration: 1100 + Math.random() * 500,
          delay: i * 70,
          easing: 'steps(12, end)',
          fill: 'both'
        }
      ).onfinish = () => el.remove()
    }
  }

  avatarWrap?.addEventListener('click', puff)
  avatarWrap?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault()
      puff()
    }
  })
</script>

<style>
  /*
   * Entrance choreography: one easing curve, no overshoot, small distances.
   * Order: background → avatar → name → links → content.
   */
  :root {
    --ease-out-soft: cubic-bezier(0.16, 1, 0.3, 1);
  }

  .hero-enter {
    position: relative;
    isolation: isolate;
  }

  /* Warm halo behind the avatar: fades in slowly and stays */
  .hero-enter::before {
    content: '';
    position: absolute;
    top: -56px;
    left: 0;
    right: 0;
    margin-inline: auto;
    z-index: -1;
    width: 280px;
    height: 280px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(196, 154, 82, 0.24), transparent 68%);
    animation: haloFade 1.8s ease-out 0.1s both;
  }

  .hero-avatar-wrap {
    position: relative;
    animation: avatarIn 1s var(--ease-out-soft) both;
  }

  .hero-avatar-wrap {
    cursor: pointer;
    border-radius: 9999px;
  }

  .hero-avatar-wrap:active :global(.hero-avatar) {
    transform: translate(1px, 1px);
  }

  .hero-avatar-wrap :global(.avatar-particle) {
    position: absolute;
    z-index: 2;
    width: 3px;
    height: 3px;
    pointer-events: none;
  }

  /* Thin ring that settles into place instead of pulsing outward */
  .hero-avatar-wrap::after {
    content: '';
    position: absolute;
    inset: -7px;
    z-index: -1;
    border-radius: 9999px;
    border: 1px solid rgba(196, 154, 82, 0.3);
    animation: ringIn 1.2s var(--ease-out-soft) 0.25s both;
  }

  .hero-avatar {
    box-shadow:
      0 18px 60px rgba(60, 40, 30, 0.12),
      0 0 0 1px rgba(196, 154, 82, 0.12);
  }

  /* Name rises out of a mask, like a line of type being set */
  .hero-title {
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .hero-title-inner {
    display: inline-block;
    animation: maskRise 1s var(--ease-out-soft) 0.2s both;
  }

  /* ---- Pixel details ---------------------------------------------------- */

  /* Status line: pixel type with a blinking block caret */
  .hero-status {
    margin-top: -0.25rem;
    font-family: 'Silkscreen', ui-monospace, monospace;
    font-size: 0.8rem;
    letter-spacing: 0.02em;
    color: hsl(var(--muted-foreground));
    animation: softFade 0.8s ease-out 0.4s both;
  }

  .hero-status-stack {
    display: inline-grid;
    justify-items: start;
  }

  .hero-status-ghost,
  .hero-status-live {
    grid-area: 1 / 1;
    white-space: nowrap;
  }

  .hero-status-ghost {
    visibility: hidden;
    padding-right: 0.8em; /* room for the caret */
  }

  .hero-status-caret {
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.2em;
    vertical-align: -0.12em;
    background: hsl(var(--primary));
    animation: caretBlink 1.05s steps(1, end) infinite;
  }

  .hero-status.is-typing .hero-status-caret {
    animation: none;
  }

  @keyframes caretBlink {
    50% {
      opacity: 0;
    }
  }

  /* Tiny pixel sparkle before each section title, built from 2px "pixels" */
  #content :global(.section-title)::before {
    content: '';
    display: inline-block;
    width: 2px;
    height: 2px;
    margin: 0 14px 0.3em 2px;
    vertical-align: middle;
    color: hsl(var(--primary));
    background: currentColor;
    box-shadow:
      0 -2px currentColor,
      0 -4px currentColor,
      0 2px currentColor,
      0 4px currentColor,
      -2px 0 currentColor,
      -4px 0 currentColor,
      2px 0 currentColor,
      4px 0 currentColor;
    transform-origin: center;
  }

  #content :global(section:hover .section-title)::before {
    animation: sparkle 0.9s steps(3, end) infinite;
  }

  @keyframes sparkle {
    0% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
    100% {
      opacity: 1;
    }
  }

  /* Cards: small lift and a thin gold outline, no heavy shadow */
  .scroll-reveal > :global(a) {
    transition:
      transform 0.3s var(--ease-out-soft),
      border-color 0.3s ease;
  }

  .scroll-reveal > :global(a:hover) {
    transform: translate3d(0, -2px, 0);
    border-color: hsl(var(--primary) / 0.55);
    box-shadow: none;
  }

  /* Skills as inventory slots: square-cornered, light up on hover */
  #content :global(.skill-slots button) {
    border-radius: 3px;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      transform 0.2s var(--ease-out-soft);
  }

  #content :global(.skill-slots button:hover) {
    transform: translate3d(0, -1px, 0);
    border-color: hsl(var(--primary) / 0.6);
    background-color: hsl(var(--primary) / 0.08);
  }

  .hero-label-item {
    animation: softRise 0.9s var(--ease-out-soft) both;
  }

  .hero-label-item:nth-child(1) {
    animation-delay: 0.5s;
  }

  .hero-label-item:nth-child(2) {
    animation-delay: 0.56s;
  }

  .hero-label-item:nth-child(3) {
    animation-delay: 0.62s;
  }

  .hero-label-item:nth-child(4) {
    animation-delay: 0.68s;
  }

  .hero-label-item:nth-child(5) {
    animation-delay: 0.74s;
  }

  /* First-screen content: pure CSS, never waits for JS */
  .first-screen-reveal {
    animation: softRise 1s var(--ease-out-soft) 0.78s both;
  }

  #content > :global(section:first-child) :global(h2) {
    animation: softFade 1s ease-out 0.72s both;
  }

  .scroll-reveal {
    opacity: 0;
    transform: translate3d(0, 16px, 0);
    transition:
      opacity 0.9s var(--ease-out-soft),
      transform 0.9s var(--ease-out-soft);
  }

  .scroll-reveal.is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .scroll-reveal-left,
  .scroll-reveal-right {
    transform: translate3d(0, 16px, 0);
  }

  .scroll-reveal-left.is-visible,
  .scroll-reveal-right.is-visible {
    transform: translate3d(0, 0, 0);
  }

  .delay-1 {
    transition-delay: 0.06s;
  }

  .delay-2 {
    transition-delay: 0.12s;
  }

  .delay-3 {
    transition-delay: 0.18s;
  }

  .blog-section-reveal.is-visible .blog-post-reveal {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }

  .blog-post-reveal {
    opacity: 0;
    transform: translate3d(0, 12px, 0);
    transition:
      opacity 0.9s var(--ease-out-soft),
      transform 0.9s var(--ease-out-soft);
  }

  @keyframes haloFade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @keyframes avatarIn {
    from {
      opacity: 0;
      transform: scale(0.94);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes ringIn {
    from {
      opacity: 0;
      transform: scale(0.9);
    }

    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes maskRise {
    from {
      transform: translate3d(0, 105%, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes softRise {
    from {
      opacity: 0;
      transform: translate3d(0, 10px, 0);
    }

    to {
      opacity: 1;
      transform: translate3d(0, 0, 0);
    }
  }

  @keyframes softFade {
    from {
      opacity: 0;
    }

    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .first-screen-reveal,
    .scroll-reveal,
    .scroll-reveal-left,
    .scroll-reveal-right,
    .blog-section-reveal,
    .blog-post-reveal,
    .hero-enter,
    .hero-enter::before,
    .hero-avatar-wrap,
    .hero-avatar-wrap::after,
    .hero-title,
    .hero-title-inner,
    .hero-status,
    .hero-status-caret,
    .hero-label-item {
      opacity: 1;
      transform: none;
      filter: none;
      animation: none;
      transition: none;
    }
  }
  html,
  body {
    overflow-x: hidden;
    max-width: 100%;
  }
</style>
